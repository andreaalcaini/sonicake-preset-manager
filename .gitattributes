# LF in the repository and in the Docker build context, whatever the OS
* text=auto eol=lf

# Windows scripts keep CRLF in the working tree
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binaries: never diffed or converted
*.dll binary
*.so binary
*.bin binary
*.clo binary
*.nam binary
*.namb binary
*.wav binary
*.png binary
*.jpg binary
*.ico binary
*.woff binary
*.woff2 binary
